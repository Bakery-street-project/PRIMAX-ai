# PRIMAX-AI Environment Configuration
# Copy this file to .env and fill in your keys

# === Core Inference ===
OLLAMA_HOST=http://127.0.0.1:11434
# NIM_API_KEY=your_nvidia_nim_api_key_here          # Highly recommended for production agents

# === Optional Cloud Providers (used as fallbacks) ===
GROQ_API_KEY=
OPENAI_API_KEY=

# === Supabase (for embeddings + logging) ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === Security / Auth (if running the FastAPI server) ===
PRIMAX_API_KEY=                    # Auto-generated on first run if missing
JWT_SECRET=change-this-to-a-long-random-string

# === Optional: Stripe / Payments (for premium tiers) ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === Development ===
DEBUG=true
LOG_LEVEL=INFO